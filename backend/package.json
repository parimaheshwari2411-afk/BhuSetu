{
  "name": "land-registry-backend",
  "version": "1.0.0",
  "description": "Smart India Hackathon - Land Registry Platform Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "db:migrate": "node dist/migrations/runner.js",
    "db:seed": "ts-node src/migrations/seed.ts",
    "contract:compile": "hardhat compile",
    "contract:deploy": "hardhat run scripts/deploy.ts --network localhost"
  },
  "keywords": ["land-registry", "blockchain", "postgis", "ipfs"],
  "author": "SIH Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "pg-promise": "^11.5.4",
    "ethers": "^6.7.1",
    "axios": "^1.6.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "joi": "^17.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "geojson": "^0.5.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/uuid": "^9.0.8",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "hardhat": "^2.19.4",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "solc": "^0.8.24"
  }
}
